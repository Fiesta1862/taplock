<!-- Merge these keys into ios/Runner/Info.plist after `flutter create`. -->
<key>NFCReaderUsageDescription</key>
<string>Taplock reads your NFC tag to start or end a focus session. Tags contain only a link, no personal data.</string>

<key>com.apple.developer.nfc.readersession.formats</key>
<array>
    <string>NDEF</string>
</array>
